# Preventis — variables de entorno del backend (API)
# Copia este archivo a /etc/preventis/preventis.env (chmod 600, dueño root)
# El instalador (deploy/install.sh) lo genera automáticamente.

# Bind y entorno
HOST=127.0.0.1            # la API escucha solo en localhost; nginx la expone
PORT=3001
NODE_ENV=production

# PostgreSQL (local o remoto)
PGHOST=localhost
PGPORT=5432
PGUSER=preventis
PGPASSWORD=CAMBIAR_password_fuerte
PGDATABASE=preventis

# Secretos (genéralos con: openssl rand -hex 32). DEBEN ser distintos entre sí.
JWT_SECRET=CAMBIAR_64_hex_aleatorios
CRED_KEY=CAMBIAR_64_hex_aleatorios_distinto   # cifra credenciales y secretos 2FA; rotarlo invalida los datos cifrados existentes

# Secreto del webhook del chatbot (WAHA/OpenWA). El gateway debe enviarlo por
# header X-Webhook-Token o como ?key= en la URL del webhook.
CHATBOT_WEBHOOK_SECRET=CAMBIAR_secreto_webhook
